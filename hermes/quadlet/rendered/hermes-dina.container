[Unit]
Description=Hermes gateway (dina)

[Service]
Restart=always

[Install]
WantedBy=default.target

[Container]
ContainerName=hermes-dina
Image=localhost/hermes-agent:20261022
Pull=never
Exec=gateway run
UserNS=keep-id:uid=10000,gid=10000
DropCapability=NET_RAW NET_ADMIN
NoNewPrivileges=true

PublishPort=2223:22
PublishPort=9122:9119

# Sandbox SSH
Volume=/home/mithras/homelab/sandbox/.ssh/dina/id_rsa:/opt/data/.ssh/id_rsa:ro
Volume=/home/mithras/homelab/sandbox/.ssh/dina/known_hosts:/opt/data/.ssh/known_hosts:ro

# Gateway SSH
Volume=/home/mithras/homelab/hermes/.ssh/dina/host_keys:/etc/ssh/host_keys:ro
Volume=/home/mithras/homelab/hermes/.ssh/dina/id_rsa.pub:/etc/ssh/authorized_keys:ro

# Gateway
Volume=/home/mithras/homelab/hermes/dina:/opt/data

Environment=TZ=America/Los_Angeles
EnvironmentFile=/home/mithras/homelab/hermes/quadlet/hermes.env
EnvironmentFile=/home/mithras/homelab/quadlet/profiles/dina/hermes.env

Network=homelab.network
Network=sandbox-dina.network
Network=browser-dina.network
