[Unit]
Description=Hermes gateway (${PROFILE})

[Service]
Restart=always

[Install]
WantedBy=default.target

[Container]
ContainerName=hermes-${PROFILE}
Image=localhost/hermes-agent:20261022
Pull=never
Exec=gateway run
UserNS=keep-id:uid=10000,gid=10000
DropCapability=NET_RAW NET_ADMIN
NoNewPrivileges=true

${HERMES_PUBLISH_PORTS}

# Sandbox SSH
Volume=/home/mithras/homelab/sandbox/.ssh/${PROFILE}/id_rsa:/opt/data/.ssh/id_rsa:ro
Volume=/home/mithras/homelab/sandbox/.ssh/${PROFILE}/known_hosts:/opt/data/.ssh/known_hosts:ro

# Gateway SSH
Volume=/home/mithras/homelab/hermes/.ssh/${PROFILE}/host_keys:/etc/ssh/host_keys:ro
Volume=/home/mithras/homelab/hermes/.ssh/${PROFILE}/id_rsa.pub:/etc/ssh/authorized_keys:ro

# Gateway
Volume=/home/mithras/homelab/hermes/${PROFILE}:/opt/data

Environment=TZ=America/Los_Angeles
EnvironmentFile=/home/mithras/homelab/hermes/quadlet/hermes.env
EnvironmentFile=/home/mithras/homelab/quadlet/profiles/${PROFILE}/hermes.env

Network=homelab.network
Network=sandbox-${PROFILE}.network
Network=browser-${PROFILE}.network
