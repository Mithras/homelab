[Unit]
Description=Hermes Excalidraw (%i)
PartOf=homelab.target

[Service]
Restart=always

[Install]
WantedBy=homelab.target

[Container]
ContainerName=excalidraw-%i
Image=ghcr.io/yctimlin/mcp_excalidraw-canvas
AutoUpdate=registry
# <none>
User=1001
UserNS=keep-id:uid=10000,gid=10000
NoNewPrivileges=true
PidsLimit=512
Memory=4g
PodmanArgs=--memory-swap=6g

Network=edge.network
Network=excalidraw@.network:alias=excalidraw
