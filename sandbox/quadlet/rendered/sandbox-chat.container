[Unit]
Description=Hermes sandbox (chat)

[Service]
Restart=always

[Install]
WantedBy=default.target

[Container]
ContainerName=sandbox-chat
Image=localhost/sandbox
Pull=never
UserNS=keep-id:uid=10000,gid=10000
DropCapability=NET_RAW NET_ADMIN
NoNewPrivileges=true

# SSH
Volume=/home/mithras/homelab/sandbox/.ssh/chat/host_keys:/etc/ssh/host_keys:ro
Volume=/home/mithras/homelab/sandbox/.ssh/chat/id_rsa.pub:/etc/ssh/authorized_keys:ro

# Hermes
Volume=/home/mithras/homelab/hermes/chat:/opt/data:ro
Volume=/home/mithras/homelab/hermes/chat/cache:/opt/data/cache
Volume=/home/mithras/homelab/hermes/chat/kanban:/opt/data/kanban
Volume=/home/mithras/homelab/hermes/chat/plans:/opt/data/plans
Volume=/home/mithras/homelab/hermes/chat/skills:/opt/data/skills
Volume=/home/mithras/homelab/hermes/chat/price-watches:/opt/data/price-watches

# Extra


Environment=TZ=America/Los_Angeles

Network=sandbox-chat.network
