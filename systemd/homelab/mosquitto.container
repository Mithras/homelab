[Unit]
Description=Mosquitto MQTT Broker
PartOf=homelab.target

[Service]
Restart=always

[Install]
WantedBy=homelab.target

[Container]
ContainerName=mosquitto
Image=docker.io/eclipse-mosquitto
AutoUpdate=registry
# <none>
User=10000
UserNS=keep-id:uid=10000,gid=10000
NoNewPrivileges=true
PidsLimit=512

Environment=TZ=America/Los_Angeles

Volume=/home/mithras/homelab/mosquitto/config:/mosquitto/config
Volume=/home/mithras/homelab/mosquitto/data:/mosquitto/data
Volume=/home/mithras/homelab/mosquitto/log:/mosquitto/log

# PublishPort=1883:1883

Network=homelab.network
